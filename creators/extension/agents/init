#!/usr/bin/env node
/* eslint-disable no-console */

/**
 * Ships the Rancher UI Extension agent guidance into a scaffolded extension.
 *
 * There is a single source of truth on disk - `files/SKILL.md` plus its reference
 * documents - and two output shapes generated from it:
 *
 *   agents (default)  AGENTS.md in the root, pointer files for the agents that
 *                     look for their own name, reference docs in
 *                     `.rancher-extension-docs/`
 *   skill             `rancher-ui-extension/` holding SKILL.md and the reference
 *                     docs as siblings, ready to drop into a skills folder. It
 *                     doubles as a Claude Code plugin
 *
 * The two shapes put the reference docs in different places, so the cross
 * references between the files are rewritten on the way out. See `README.md`
 * in this folder before editing the source documents.
 */

const path = require('path');
const fs = require('fs-extra');

const SOURCE_FOLDER = path.join(__dirname, 'files');

const CORE_FILE = 'SKILL.md';
const REFERENCE_FILES = [
  'rancher-ui-components.md',
  'rancher-ui-patterns.md',
  'rancher-ui-styling.md'
];

// Where each output shape puts things
const AGENTS_FILE = 'AGENTS.md';
const AGENTS_REFERENCE_FOLDER = '.rancher-extension-docs';
const SKILL_FOLDER = 'rancher-ui-extension';
const PLUGIN_MANIFEST = path.join('.claude-plugin', 'plugin.json');

/**
 * AGENTS.md holds the guidance. Agents that look for a file of their own name
 * get a pointer to it, so there is only ever one copy to maintain.
 *
 * Claude Code and Gemini CLI both inline an `@` reference; Gemini wants the
 * leading `./`. Codex reads AGENTS.md directly and has no import syntax, so
 * GPT.md is a signpost for a reader who opens it rather than a directive.
 */
const POINTER_FILES = {
  'CLAUDE.md': `@${ AGENTS_FILE }\n`,
  'GEMINI.md': `@./${ AGENTS_FILE }\n`,
  'GPT.md':    `See [${ AGENTS_FILE }](./${ AGENTS_FILE }) for the guidance that applies to this repository.\n`
};

const AGENTS_HEADER = `<!--
  Generated by @rancher/create-extension.

  Guidance for AI coding agents working on this Rancher UI Extension. The
  reference documents it links to live in ./${ AGENTS_REFERENCE_FOLDER }/.
  ${ Object.keys(POINTER_FILES).join(', ') } all point here.

  To regenerate these files, or to get the same guidance as a skill
  instead, run:

    npm init @rancher/extension@latest -- --agents
    npm init @rancher/extension@latest -- --skill
-->

`;

/**
 * Manifest that turns the skill folder into a Claude Code plugin.
 *
 * A plugin with SKILL.md at its root, no `skills/` folder and no `skills` key
 * loads as a single skill, so the manifest only carries metadata. The version
 * tracks the creator, which is what the guidance shipped with.
 */
function pluginManifest() {
  const creatorPkg = JSON.parse(fs.readFileSync(path.join(__dirname, '..', 'package.json'), 'utf8'));

  return `${ JSON.stringify({
    name:        SKILL_FOLDER,
    displayName: 'Rancher UI Extension',
    version:     creatorPkg.version,
    description: 'Build, extend, refactor and debug Rancher UI Extensions, in line with SUSE UX standards',
    author:      { name: 'SUSE', url: 'https://github.com/rancher/dashboard' },
    homepage:    'https://extensions.rancher.io/extensions/next/',
    repository:  'https://github.com/rancher/dashboard',
    license:     'Apache-2.0',
    keywords:    ['rancher', 'suse', 'kubernetes', 'vue', 'extensions']
  }, null, 2) }\n`;
}

/**
 * Escape a string for literal use inside a RegExp.
 */
function escapeRegExp(value) {
  return value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}

/**
 * Drop the YAML frontmatter block from a markdown document.
 *
 * The frontmatter carries the skill name, description and argument hint, which
 * only mean something to a skill loader. AGENTS.md is read as plain markdown.
 */
function stripFrontmatter(content) {
  if (!content.startsWith('---')) {
    return content;
  }

  const closing = content.indexOf('\n---', 3);

  if (closing === -1) {
    return content;
  }

  const bodyStart = content.indexOf('\n', closing + 1);

  return bodyStart === -1 ? '' : content.slice(bodyStart + 1).replace(/^\n+/, '');
}

/**
 * Rewrite the core document for the agents shape.
 *
 * Two kinds of change: the reference documents move into a subfolder, and the
 * handful of sentences that describe the document as a skill no longer apply.
 */
function toAgentsCore(content) {
  let out = stripFrontmatter(content);

  REFERENCE_FILES.forEach((file) => {
    out = out.replace(new RegExp(`\`${ escapeRegExp(file) }\``, 'g'), `\`${ AGENTS_REFERENCE_FOLDER }/${ file }\``);
  });

  const rewrites = [
    [/^A skill for building/m, 'Guidance for building'],
    [/this skill does not/g, 'this file does not'],
    [/If a snippet in this skill disagrees/g, 'If a snippet in this file disagrees'],
    [/so the skill can be corrected/g, 'so this file can be corrected'],
    [/^This skill covers everything/m, 'This guide covers everything'],
    [/^Request \(empty if the skill self-triggered[^\n]*\$ARGUMENTS$/m, 'Request: take it from the user\'s message and the surrounding conversation.']
  ];

  rewrites.forEach(([from, to]) => {
    out = out.replace(from, to);
  });

  return AGENTS_HEADER + out;
}

/**
 * Rewrite a reference document for the agents shape.
 *
 * The reference documents sit alongside each other in both shapes, so their
 * cross references hold. Only the pointers back to the core document change.
 */
function toAgentsReference(content) {
  return content.replace(new RegExp(`\`${ escapeRegExp(CORE_FILE) }\``, 'g'), `\`${ AGENTS_FILE }\``);
}

/**
 * Write a file unless something is already there - the creator never clobbers
 * work a developer may have edited.
 */
function write(destination, content, label) {
  if (fs.existsSync(destination)) {
    console.log(`  Skipping ${ label } - already exists`);

    return false;
  }

  fs.ensureDirSync(path.dirname(destination));
  fs.writeFileSync(destination, content);
  console.log(`  Adding file: ${ label }`);

  return true;
}

function read(file) {
  return fs.readFileSync(path.join(SOURCE_FOLDER, file), 'utf8');
}

/**
 * AGENTS.md + CLAUDE.md in the root, reference docs in a subfolder.
 */
function createAgentsFiles(targetFolder) {
  console.log('');
  console.log('Adding agent guidance (AGENTS.md)');

  write(path.join(targetFolder, AGENTS_FILE), toAgentsCore(read(CORE_FILE)), AGENTS_FILE);

  Object.keys(POINTER_FILES).forEach((file) => {
    write(path.join(targetFolder, file), POINTER_FILES[file], file);
  });

  REFERENCE_FILES.forEach((file) => {
    const relative = path.join(AGENTS_REFERENCE_FOLDER, file);

    write(path.join(targetFolder, relative), toAgentsReference(read(file)), relative);
  });

  console.log('Agent guidance added.\n');
}

/**
 * A self-contained skill folder, copied through untouched.
 */
function createSkillFiles(targetFolder) {
  console.log('');
  console.log('Adding agent guidance (skill)');

  [CORE_FILE, ...REFERENCE_FILES].forEach((file) => {
    const relative = path.join(SKILL_FOLDER, file);

    write(path.join(targetFolder, relative), read(file), relative);
  });

  const manifest = path.join(SKILL_FOLDER, PLUGIN_MANIFEST);

  write(path.join(targetFolder, manifest), pluginManifest(), manifest);

  console.log(`Skill added. Copy '${ SKILL_FOLDER }' into your agent's skills folder, for example .claude/skills.`);
  console.log(`It is also a Claude Code plugin, so 'claude --plugin-dir ./${ SKILL_FOLDER }' loads it for a session.\n`);
}

module.exports = { createAgentsFiles, createSkillFiles };

// Also runnable directly: node agents/init <target-folder> [--skill]
if (require.main === module) {
  const args = process.argv.slice(2);
  const targetFolder = path.resolve(args.find((arg) => !arg.startsWith('-')) || '.');

  if (args.includes('--skill')) {
    createSkillFiles(targetFolder);
  } else {
    createAgentsFiles(targetFolder);
  }
}

/* eslint-enable no-console */
