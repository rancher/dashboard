#!/usr/bin/env bash

GITHUB_RELEASE_TAG=$1
GITHUB_RUN_ID=$2
GITHUB_WORKFLOW_TYPE=$3

echo "Parse tag name - evaluating release tag $GITHUB_RELEASE_TAG"

# Ensure "catalog" workflow release tag name matches the root <pkg-name>
if [[ "${GITHUB_WORKFLOW_TYPE}" == "catalog" ]]; then
  BASE_EXT=$(jq -r .name package.json)
  EXT_VERSION=$(jq -r .version package.json)

  if [[ "${GITHUB_RELEASE_TAG}" != "${BASE_EXT}-${EXT_VERSION}" ]]; then
    echo -e "release tag doesn't match catalog tag: release tag -> ${GITHUB_RELEASE_TAG} ::: curr catalog tag -> ${BASE_EXT}-${EXT_VERSION}"
    gh run cancel ${GITHUB_RUN_ID}
    exit 1
  fi
# Ensure a "bundle" release tag matches some rancher.bundles[] entry. Bundle tags are
# self-identifying - "bundle-<name>-<version>" - so the shape of the tag selects this
# branch rather than a separate workflow input, and one release workflow can publish
# both individual extensions and bundles.
#
# Both halves of the tag can contain hyphens - the name, and a prerelease version such
# as 1.0.0-rc.1 - so the tag cannot be split on one. Rebuild the expected tag from each
# declared bundle instead and compare whole strings, the way the chart branch below
# matches against pkg/<name>.
elif [[ "${GITHUB_RELEASE_TAG}" == bundle-* ]]; then
  BUNDLE=$(jq -c --arg tag "${GITHUB_RELEASE_TAG}" \
    '(.rancher.bundles // []) | map(select("bundle-" + .name + "-" + .version == $tag)) | .[0] // empty' package.json)

  if [[ -z "${BUNDLE}" ]]; then
    echo -e "release tag doesn't match any bundle: ${GITHUB_RELEASE_TAG}"
    echo -e "Expected bundle-<name>-<version> for an entry in rancher.bundles[] of the root package.json. Declared bundles:"
    jq -r '(.rancher.bundles // [])[] | "  bundle-\(.name)-\(.version)"' package.json
    gh run cancel ${GITHUB_RUN_ID}
    exit 1
  fi

  BUNDLE_NAME=$(jq -r '.name' <<<"${BUNDLE}")
  BUNDLE_VERSION=$(jq -r '.version' <<<"${BUNDLE}")

  echo "Parsed as a bundle release: name '${BUNDLE_NAME}', version '${BUNDLE_VERSION}'"
# Ensure "chart" workflow release tag name matches some pkg/<pkg-name>
else
  NO_MATCHES="true"

  for d in pkg/*/ ; do
    pkg=$(basename $d)

    PKG_VERSION=$(jq -r .version pkg/${pkg}/package.json)
    CURR_PKG_TAG="${pkg}-${PKG_VERSION}"

    if [[ "${GITHUB_RELEASE_TAG}" == "${CURR_PKG_TAG}" ]]; then
      NO_MATCHES="false"
    fi
  done

  if [[ "${NO_MATCHES}" == "true" ]]; then
    echo -e "release tag doesn't match any chart tag: ${GITHUB_RELEASE_TAG}. Check your pkg/<!-YOUR-EXT-> folders and corresponding versions to complete the match"
    gh run cancel ${GITHUB_RUN_ID}
    exit 1
  fi
fi
